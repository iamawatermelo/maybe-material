    token "on-secondary"              apply="secondary-palette"       t=20
    token "secondary-container"       apply="secondary-palette"       t=30
    token "on-secondary-container"    apply="secondary-palette"       t=90
    token "tertiary"                  apply="tertiary-palette"        t=80
    token "on-tertiary"               apply="tertiary-palette"        t=20
    token "tertiary-container"        apply="tertiary-palette"        t=30
    token "on-tertiary-container"     apply="tertiary-palette"        t=90

    // Error colours
    token "error"                     apply="error-palette"           t=80
    token "on-error"                  apply="error-palette"           t=20
    token "error-container"           apply="error-palette"           t=30
    token "on-error-container"        apply="error-palette"           t=90

    // Custom semantic colours
    token "success"                   apply="success-palette"         t=80
    token "on-success"                apply="success-palette"         t=20
    token "success-container"         apply="success-palette"         t=30
    token "on-success-container"      apply="success-palette"         t=90
    token "warning"                   apply="warning-palette"         t=80
    token "on-warning"                apply="warning-palette"         t=20
    token "warning-container"         apply="warning-palette"         t=30
    token "on-warning-container"      apply="warning-palette"         t=90
    token "info"                      apply="info-palette"            t=80
    token "on-info"                   apply="info-palette"            t=20
    token "info-container"            apply="info-palette"            t=30
    token "on-info-container"         apply="info-palette"            t=90

    // Surface & background colours
    token "background"                apply="neutral-palette"         t=10
    token "on-background"             apply="neutral-palette"         t=90
    token "surface"                   apply="neutral-palette"         t=5
    token "on-surface"                apply="neutral-palette"         t=90
    token "syntax-base"               apply="neutral-palette"         t=75 c="+20"
    token "surface-variant"           apply="neutral-variant-palette" t=30
    token "on-surface-variant"        apply="neutral-variant-palette" t=80
    token "surface-dim"               apply="neutral-palette"         t=6
    token "surface-bright"            apply="neutral-palette"         t=24
    token "surface-container-lowest"  apply="neutral-palette"         t=4
    token "surface-container-low"     apply="neutral-palette"         t=8
    token "surface-container"         apply="neutral-palette"         t=10
    token "surface-container-high"    apply="neutral-palette"         t=12
    token "surface-container-highest" apply="neutral-palette"         t=14

    // Utility & overlay colours
    token "outline"                   apply="neutral-variant-palette" t=60
    token "outline-variant"           apply="neutral-variant-palette" t=30
    token "shadow"                    apply="neutral-palette"         t=0
    token "scrim"                     apply="neutral-palette"         t=0

    // Inverse colours (for light elements on a dark surface)
    token "inverse-surface"           apply="neutral-palette"         t=90
    token "inverse-on-surface"        apply="neutral-palette"         t=20
    token "inverse-primary"           apply="primary-palette"         t=40

    // Player colours
    token "player-cursor"             t=70
    token "player-selection"          t=30
}

